{{ ansible_managed | comment }}
<VirtualHost *:{{ nextcloud_apache_port }}>
    ServerName {{ nextcloud_domain }}
    DocumentRoot {{ nextcloud_install_dir }}

    <Directory {{ nextcloud_install_dir }}>
        Require all granted
        AllowOverride All
        Options FollowSymLinks MultiViews

        <IfModule mod_dav.c>
            Dav off
        </IfModule>
    </Directory>

    <FilesMatch "\.php$">
        SetHandler "proxy:unix:/run/php/php{{ nextcloud_php_version }}-fpm.sock|fcgi://localhost/"
    </FilesMatch>

    ErrorLog ${APACHE_LOG_DIR}/nextcloud-error.log
    CustomLog ${APACHE_LOG_DIR}/nextcloud-access.log combined
</VirtualHost>
